{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-prototype",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/api/IdeaDiscovery.Api", "--launch-profile", "http"],
      "port": 5270,
      "url": "http://localhost:5270"
    },
    {
      "name": "web-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/web", "run", "dev:api"],
      "port": 5173
    },
    {
      "name": "pages-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": ["src/web/node_modules/vite/bin/vite.js", "preview", "src/web", "--base=/idea-discovery-app/", "--port", "4173", "--strictPort"],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
