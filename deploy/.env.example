# Copy to .env (same folder), then: chmod 600 .env
# Never commit .env. Values are plain text: no quotes, no spaces around "=".
# Secrets are left empty here on purpose; docs/deployment.md says how to fill them.

# ---- Which build runs -------------------------------------------------------
# The full commit SHA of the images to run. Never "latest". update.sh and
# rollback.sh change this line.
IMAGE_TAG=

# ---- Where it runs ----------------------------------------------------------
# The address people use, without https://. Caddy fetches its certificate for it.
APP_DOMAIN=rooms.example.com
# The same address as a link, https only. Sign-in links are built from it.
App__PublicBaseUrl=https://rooms.example.com

# Host folder for the database, the Data Protection keys and the pre-update copies.
# Create it once: sudo install -d -o 1654 -g 1654 -m 700 /srv/idea-discovery/data
DATA_DIR=/srv/idea-discovery/data

# The one proxy the API believes about visitors' addresses. It is Caddy's fixed
# address on the compose network (subnet 172.28.7.0/24). Do not change it unless
# you change the subnet in docker-compose.yml too.
Proxy__KnownProxy=172.28.7.10

# ---- People -----------------------------------------------------------------
# The one consultant (Burak). Signs in by emailed link.
Consultant__Email=

# ---- Secrets ----------------------------------------------------------------
# Hashes every sign-in link. At least 32 characters. Generate with:
#   openssl rand -base64 48
# Changing it makes every unused sign-in link stop working.
Auth__TokenKey=

# ---- Email (Resend) ---------------------------------------------------------
Email__Provider=Resend
# The sender, on the domain verified at Resend, for example: Rooms <noreply@rooms.example.com>
Email__From=
# A Resend API key with sending access only, for that domain.
Email__Resend__ApiKey=
